#!/usr/bin/env rexx

args = "-std=ibm -ftrace -g"
args = args "-O3"
args = args "-fsign=ebcdic"
args = args "-fdefault-colseq=ebcdic"
args = args "-febcdic-table=ebcdic500_latin1"
args = args "-fstatic-call -static"
args = args "-fnotrunc"
args = args "-farithmetic-osvs"
args = args "-W -Wno-possible-truncate -Wno-call-params"
args = args "-I .."

args = args "-Werror"

main_file = "../src/main.cbl"
files.0   = 13
files.1   = "../src/output.cbl"
files.2   = "../src/wto.cbl"
files.3   = "../src/auto-detect.cbl"
files.4   = "../src/modules/time.cbl"
files.5   = "../src/modules/date.cbl"
files.6   = "../src/modules/load.cbl"
files.7   = "../src/modules/memory.cbl"
files.8   = "../src/modules/battery.cbl"
files.9   = "../src/modules/system.cbl"
files.10   = "../src/modules/text.cbl"
files.11  = "../src/modules/separator.cbl"
files.12  = "../src/modules/space.cbl"
files.13  = "../src/modules/path.cbl"
files.14  = "../src/modules/tape.cbl"

arg command other
if command = "" then command = "COMPILE"

select
  when command = "COMPILE" then do
      command = "mkdir -p build"
      SAY ' STEP01 ===> ' command
      command
      command = "./generate_copybooks.sh"
      SAY ' STEP02 ===> ' command ' INTO ./COPYBOOKS/LIBC.CPY'
      command
      command = "gcc -c ./helper.c -o build/binops.o "
      SAY ' STEP03 ===> ' command
      command
      objects = "main.o"
      command = "cobc " args "-c -x" main_file "-o" "main.o"
      "cd build && "command
      do i = 1 to files.0
        command = "cobc " args "-c " files.i "-o" "o"i".o"
        out = ""(i + 3)
        if i < 7 then out = "0"out
        SAY " STEP"out "===> " command
        "cd build && "command
        if RC = 0 then 
          do
          end
        else
          do
            say "Compile failed, RC=" RC
            exit RC
          end
        SAY RC
        objects = objects "o"i".o"
      end

      SAY " STEPCOMP ===> "
      command = "cob-config --libs"
      SAY "    ===> " command
      address system command WITH OUTPUT STEM target.
      command = "cobc -x binops.o" args objects " -o statusline"
      SAY "    ===> " command
      "cd build && "command

      command = "cp ./build/statusline ."
      SAY ' FINAL ===> ' command
      command
    end
  when command = "TEST" then do
    "./TESTS/TEST.EXEC" 
    end
  otherwise do
    say "BUILD.EXEC SUPPORTS ONLY 'COMPILE' OR 'TEST' SUB COMMANDS"
    say "COMMAND: '"command"' is not recognised"
  end
end

exit rc
